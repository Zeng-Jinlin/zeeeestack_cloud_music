{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend",
      "type": "java",
      "request": "launch",
      "mainClass": "com.zeeeestack.music.CloudMusicApplication",
      "projectName": "cloud-music",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "Frontend",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Backend", "Frontend"],
      "stopAll": true
    }
  ]
}